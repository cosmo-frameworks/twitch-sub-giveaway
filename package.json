{
  "name": "twitch-sub-giveaway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/cosmo-frameworks/twitch-sub-giveaway.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "auth": "tsx src/auth/cli.ts",
    "panel:dev": "pnpm --filter twitch-sorteo-panel dev",
    "panel:build": "pnpm --filter twitch-sorteo-panel build",
    "desktop:dev": "pnpm desktop:build && electron dist-desktop/main.js",
    "desktop:build": "pnpm icon && pnpm panel:build && tsup --config tsup.desktop.config.ts",
    "icon": "tsx scripts/make-icon.ts",
    "desktop:package": "pnpm desktop:build && electron-builder --win --publish never",
    "desktop:release": "pnpm desktop:build && electron-builder --win --publish always",
    "start": "node dist/index.js",
    "build": "tsup",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit && tsc -p desktop/tsconfig.json --noEmit && pnpm --filter twitch-sorteo-panel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@twurple/api": "^8.1.4",
    "@twurple/auth": "^8.1.4",
    "@twurple/common": "^8.1.4",
    "@twurple/eventsub-ws": "^8.1.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "fastify": "^5.12.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "main": "dist-desktop/main.js"
}
