# NO HACE FALTA NINGUNA VARIABLE.
#
# La aplicación arranca sin .env: el client id va compilado, el secreto no se
# usa (el flujo de dispositivo no lo necesita) y el canal es quien autorice.
# Todo lo de aquí son overrides de desarrollo.
#
# .env está en .gitignore: nunca lo subas.

# Solo para apuntar a otra app de Twitch en desarrollo.
TWITCH_CLIENT_ID=

# Solo para `pnpm auth`, que usa el flujo por navegador. La aplicación
# instalada no lo necesita ni lo lleva dentro.
TWITCH_CLIENT_SECRET=

# Aborta si se autoriza con una cuenta distinta a esta. Normalmente vacío:
# el canal es el de quien autorice.
TWITCH_BROADCASTER_LOGIN=


# Vacío en producción (usa el EventSub real de Twitch).
# En local, con el mock del Twitch CLI:
#   twitch event websocket start-server
# TWITCH_WS_URL=ws://127.0.0.1:8080/ws
TWITCH_WS_URL=

# Por defecto se deriva de PORT: http://localhost:3000/callback
# OAUTH_REDIRECT_URI=http://localhost:3000/callback

PORT=3000
LOG_LEVEL=info

# Dónde se guardan los datos
# No hace falta configurar nada. Por defecto todo va a la carpeta de datos del
# usuario, que es absoluta y no depende de desde dónde se arranque la app:
#
#   Windows   %APPDATA%\twitch-sorteos\
#   macOS     ~/Library/Application Support/twitch-sorteos/
#   Linux     ~/.local/share/twitch-sorteos/
#
# El streamer cambia la carpeta de la base de datos desde la propia app; queda
# guardado en settings.json dentro de esa carpeta. Nunca necesita tocar esto.
#
# Lo de abajo son overrides de DESARROLLO y de despliegue en servidor: ganan a
# lo que el streamer haya elegido en la app.

# Mueve la carpeta de datos entera (base de datos + tokens + settings).
# TWITCH_SORTEOS_DATA_DIR=./.dev-data

# Mueve solo la base de datos.
# DB_PATH=./.dev-data/sorteos.db

# Mueve solo el fichero de tokens.
# TOKENS_PATH=./.dev-data/tokens.json

# Pruebas con el Twitch CLI
# Hacen falta LAS DOS variables. TWITCH_WS_URL solo redirige el WebSocket;
# las suscripciones de EventSub se crean por Helix y seguirían yendo a
# api.twitch.tv. TWURPLE_MOCK_API_PORT redirige ambas cosas.
#
#   twitch event websocket start-server
#   TWITCH_WS_URL=ws://127.0.0.1:8080/ws
#   TWURPLE_MOCK_API_PORT=8080
